// CardShot 设备端界面（320×170）：后台截图/录屏守护的相册管理前端
// 视觉规范：8px 基线栅格；正文 10/12px；三种语义色（表面/描边/强调）

export struct GalleryItem {
    img: image,
    kind: string,
    name: string,
    sub: string,
    dur: string,
}

// 主色板
// bg #0B0E11  surface #14191E  surface2 #1A2027  border #262E36
// text #E6EDF3  muted #94A3B2  faint #5C6773  accent #2DD4BF  danger #F26D6D

component TopBar inherits Rectangle {
    in property <string> title: "CardShot";
    in property <bool> recording: false;
    in property <string> rec-time: "";
    in property <bool> overlay: false;
    in property <bool> wide-right: false;
    height: 20px;
    background: root.overlay ? #0B0E11D8 : #0B0E11;
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #1C242B; }
    Text {
        x: 10px; y: 0; width: parent.width - (root.wide-right ? 156px : 74px); height: parent.height; vertical-alignment: center; overflow: elide;
        text: root.title; color: #E6EDF3;
        font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px; font-weight: 700;
    }
    if root.recording : Rectangle {
        x: parent.width - 62px; y: 4px; width: 52px; height: 14px; border-radius: 7px;
        background: #2A1518;
        Rectangle { x: 6px; y: 5px; width: 5px; height: 5px; border-radius: 3px; background: #F26D6D; }
        Text {
            x: 16px; y: 0; width: 32px; height: parent.height; vertical-alignment: center;
            text: root.rec-time; color: #F6A5A5;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        }
    }
}

component StatChip inherits Rectangle {
    in property <image> icon;
    in property <string> value: "0";
    in property <string> label: "";
    height: 28px;
    border-radius: 8px;
    background: #14191E;
    border-width: 1px;
    border-color: #202830;
    Image {
        x: 10px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: root.icon; opacity: 1.0;
    }
    Text {
        x: 27px; y: 0; height: parent.height; vertical-alignment: center;
        text: root.value; color: #E6EDF3;
        font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px; font-weight: 700;
    }
    Text {
        x: parent.width - 40px; y: 0; width: 30px; height: parent.height; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.right;
        text: root.label; color: #5C6773;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
    }
}

component ActionRow inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <string> right: "";
    in property <bool> focused: false;
    height: 26px;
    border-radius: 8px;
    background: focused ? #17262B : #14191E;
    border-width: 1px;
    border-color: focused ? #2DD4BF : #202830;
    animate background { duration: 110ms; }
    animate border-color { duration: 110ms; }
    Image {
        x: 10px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: root.icon; opacity: root.focused ? 1.0 : 0.72;
    }
    Text {
        x: 30px; y: 0; height: parent.height; vertical-alignment: center;
        text: root.label; color: #E6EDF3;
        font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px;
    }
    if root.right != "" : Text {
        x: parent.width - 62px; y: 0; width: 42px; height: parent.height; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.right;
        text: root.right; color: #94A3B2;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
    }
    Image {
        x: parent.width - 21px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: @image-url("icons/arrow-right.svg");
        opacity: root.focused ? 0.9 : 0.28;
        animate opacity { duration: 110ms; }
    }
}

component HomeScreen inherits Rectangle {
    in property <int> focus-idx: 0;
    in property <int> count-images: 0;
    in property <int> count-videos: 0;
    in property <string> size-label: "";
    width: 100%; height: 100%; background: transparent;

    StatChip { x: 9px;  y: 27px; width: 148px; icon: @image-url("icons/camera.svg"); value: root.count-images; label: "截图"; }
    StatChip { x: 163px; y: 27px; width: 148px; icon: @image-url("icons/video.svg"); value: root.count-videos; label: "录制"; }

    ActionRow {
        x: 9px; y: 63px; width: 302px;
        icon: @image-url("icons/gallery-thumbnails.svg");
        label: "相册"; right: (root.count-images + root.count-videos) + " 项";
        focused: root.focus-idx == 0;
    }
    ActionRow {
        x: 9px; y: 93px; width: 302px;
        icon: @image-url("icons/settings-cog.svg");
        label: "设置"; focused: root.focus-idx == 1;
    }
    ActionRow {
        x: 9px; y: 123px; width: 302px;
        icon: @image-url("icons/book-open.svg");
        label: "使用说明"; focused: root.focus-idx == 2;
    }
}

component GalleryTile inherits Rectangle {
    in property <image> img;
    in property <string> kind: "";
    in property <string> label: "";
    in property <string> dur: "";
    in property <bool> focused: false;
    in property <bool> selecting: false;
    in property <bool> check: false;
    border-radius: 8px;
    background: #14191E;
    border-width: 1px;
    border-color: #202830;
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%; border-radius: 8px; clip: true;
        Image {
            x: 0; y: 0; width: parent.width; height: parent.height - 14px;
            source: root.img; image-fit: contain;
        }
    }
    Rectangle { x: 4px; y: 4px; width: 16px; height: 16px; border-radius: 4px; background: #000000B0; }
    Image { x: 6px; y: 6px; width: 12px; height: 12px; source: @image-url("icons/camera.svg"); visible: root.kind == "image"; }
    Image { x: 6px; y: 6px; width: 12px; height: 12px; source: @image-url("icons/play.svg"); visible: root.kind == "video"; }
    Image {
        x: (parent.width - 24px) / 2; y: (parent.height - 14px - 24px) / 2;
        width: 24px; height: 24px; source: @image-url("icons/play-circle.svg");
        visible: root.kind == "video" && !root.selecting; opacity: 0.92;
    }
    if root.dur != "" && !root.selecting : Rectangle {
        x: parent.width - 36px; y: 4px; width: 32px; height: 13px; border-radius: 4px; background: #000000B0;
        Text {
            x: 0; y: 0; width: parent.width; height: parent.height; vertical-alignment: center;
            horizontal-alignment: TextHorizontalAlignment.center;
            text: root.dur; color: #FFFFFF;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        }
    }
    if root.selecting : Rectangle {
        x: parent.width - 21px; y: 4px; width: 16px; height: 16px; border-radius: 8px;
        background: root.check ? #2DD4BF : #000000B0;
        border-width: 1px; border-color: root.check ? #2DD4BF : #4C5865;
        Image {
            x: 3px; y: 3px; width: 10px; height: 10px;
            source: @image-url("icons/check.svg"); visible: root.check;
        }
    }
    Rectangle {
        y: parent.height - 14px; width: parent.width; height: 14px; background: #1A2027;
        Text {
            x: 5px; width: parent.width - 10px; height: parent.height; vertical-alignment: center;
            text: root.label; color: #AEBAC6;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; overflow: elide;
        }
    }
    if root.focused : Rectangle {
        x: 0; y: 0; width: 100%; height: 100%; border-radius: 8px;
        background: transparent; border-width: 2px; border-color: #2DD4BF;
    }
}

component GalleryScreen inherits Rectangle {
    in property <[GalleryItem]> items;
    in property <int> focus-idx: 0;
    in property <bool> selecting: false;
    in property <int> sel-count: 0;
    width: 100%; height: 100%; background: transparent;
    for it[i] in root.items : GalleryTile {
        x: 8px + Math.mod(i, 3) * 103px;
        y: 26px + Math.floor(i / 3) * 65px;
        width: 98px; height: 59px;
        img: it.img; kind: it.kind; label: it.name; dur: it.dur;
        focused: root.focus-idx == i && !root.selecting;
        selecting: root.selecting;
    }
    Rectangle {
        visible: root.items.length == 0;
        x: 0; y: 50px; width: parent.width; height: 50px;
        Text {
            x: 0; y: 0; width: parent.width; horizontal-alignment: TextHorizontalAlignment.center;
            text: "还没有内容"; color: #94A3B2;
            font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px;
        }
        Text {
            x: 0; y: 20px; width: parent.width; horizontal-alignment: TextHorizontalAlignment.center;
            text: "用热键截图或录制后会自动出现"; color: #5C6773;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        }
    }
}

component ArrowPad inherits Rectangle {
    in property <image> icon;
    width: 20px; height: 34px; border-radius: 5px;
    background: #141E22; border-width: 1px; border-color: #262E36;
    Image { x: 4px; y: 11px; width: 12px; height: 12px; source: root.icon; opacity: 0.85; }
}

component PreviewScreen inherits Rectangle {
    in property <image> img;
    in property <string> name: "";
    in property <string> size-label: "";
    in property <string> dur: "";
    in property <string> kind: "image";
    in property <string> pos: "";
    in property <bool> ended: false;
    width: 100%; height: 100%; background: transparent;
    if root.ended : Rectangle {
        x: (parent.width - 48px) / 2; y: (parent.height - 48px) / 2; width: 48px; height: 48px;
        border-radius: 24px; background: #000000A6; border-width: 1px; border-color: #FFFFFF59;
        Image { x: 17px; y: 17px; width: 14px; height: 14px; source: @image-url("icons/play.svg"); }
    }
    // 位置与体积：右上浮层，不占布局
    Text {
        x: parent.width - 158px; y: 2px; width: 150px; height: 16px; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.right;
        text: root.pos + "   " + root.size-label; color: #C8D2DC;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px;
    }
    // 左右切换：半透明悬浮按钮，压在图片上
    Rectangle {
        x: 6px; y: (parent.height - 40px) / 2; width: 24px; height: 40px; border-radius: 6px;
        background: #00000066; border-width: 1px; border-color: #FFFFFF2E;
        Image { x: 6px; y: 14px; width: 12px; height: 12px; source: @image-url("icons/arrow-left.svg"); opacity: 0.95; }
    }
    Rectangle {
        x: parent.width - 30px; y: (parent.height - 40px) / 2; width: 24px; height: 40px; border-radius: 6px;
        background: #00000066; border-width: 1px; border-color: #FFFFFF2E;
        Image { x: 6px; y: 14px; width: 12px; height: 12px; source: @image-url("icons/arrow-right.svg"); opacity: 0.95; }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <int> mode: 0;      // 0 文本 / 1 格式段选 / 2 远程开关
    in property <bool> focused: false;
    in property <bool> disabled: false;
    height: 18px;
    border-radius: 5px;
    background: focused ? #16302F : transparent;
    border-width: root.focused ? 1px : 0px;
    border-color: #2DD4BF;
    Text {
        x: 8px; width: 70px; height: parent.height; vertical-alignment: center;
        text: root.label; color: root.disabled ? #566270 : (root.focused ? #E6EDF3 : #AEBAC6);
        font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 11px;
    }
    if root.mode == 0 : Text {
        x: parent.width - 130px; width: 120px; height: parent.height; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.right;
        text: root.value; color: root.disabled ? #566270 : (root.focused ? #2DD4BF : #C8D2DC);
        font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 11px;
    }
    if root.mode == 1 : Rectangle {
        x: parent.width - 122px; y: 3px; width: 114px; height: 13px; opacity: root.disabled ? 0.4 : 1.0;
        border-radius: 4px; background: #10161B; border-width: 1px; border-color: #263038;
        Rectangle { x: 1px; y: 1px; width: 36px; height: 11px; border-radius: 3px; background: root.value == "PNG"  ? #2DD4BF : transparent; }
        Rectangle { x: 39px; y: 1px; width: 36px; height: 11px; border-radius: 3px; background: root.value == "JPEG" ? #2DD4BF : transparent; }
        Rectangle { x: 77px; y: 1px; width: 36px; height: 11px; border-radius: 3px; background: root.value == "WEBP" ? #2DD4BF : transparent; }
        Text { x: 1px; y: 0; width: 36px; height: parent.height; vertical-alignment: center; horizontal-alignment: TextHorizontalAlignment.center; text: "PNG";  color: root.value == "PNG"  ? #04221F : #8B98A6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px; }
        Text { x: 39px; y: 0; width: 36px; height: parent.height; vertical-alignment: center; horizontal-alignment: TextHorizontalAlignment.center; text: "JPEG"; color: root.value == "JPEG" ? #04221F : #8B98A6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px; }
        Text { x: 77px; y: 0; width: 36px; height: parent.height; vertical-alignment: center; horizontal-alignment: TextHorizontalAlignment.center; text: "WebP"; color: root.value == "WEBP" ? #04221F : #8B98A6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px; }
    }
    if root.mode == 2 : Text {
        x: parent.width - 96px; width: 62px; height: parent.height; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.right;
        text: root.value; color: #2DD4BF;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px;
    }
    if root.mode == 2 : Rectangle {
        x: parent.width - 30px; y: 3px; width: 26px; height: 13px; border-radius: 7px;
        background: root.value != "关" ? #2DD4BF : #2A3A44;
        Rectangle {
            x: root.value != "关" ? 14px : 2px; y: 2px; width: 9px; height: 9px; border-radius: 5px; background: #FFFFFF;
        }
    }
}

component SettingsScreen inherits Rectangle {
    in property <int> focus-idx: 0;
    in property <string> fmt: "PNG";
    in property <string> port-text: "8420";
    in property <string> shot-text: "shift+space";
    in property <bool> port-disabled: false;
    in property <int> quality: 90;
    in property <int> fps: 20;
    in property <int> port: 8420;
    in property <string> shot: "";
    in property <string> remote: "开";
    width: 100%; height: 100%; background: transparent;
    SettingRow { x: 8px; y: 20px;  width: 304px; label: "图片格式";   mode: 1; value: root.fmt; focused: root.focus-idx == 0; }
    SettingRow { x: 8px; y: 38px;  width: 304px; label: "压缩质量";   mode: 0; value: root.quality; focused: root.focus-idx == 1; }
    SettingRow { x: 8px; y: 56px;  width: 304px; label: "录制帧率";   mode: 0; value: root.fps; focused: root.focus-idx == 2; }
    SettingRow { x: 8px; y: 74px;  width: 304px; label: "截图快捷键"; mode: 0; value: root.shot-text; focused: root.focus-idx == 3; }
    SettingRow { x: 8px; y: 92px;  width: 304px; label: "Web管理面板"; mode: 2; value: root.remote; focused: root.focus-idx == 4; }
    SettingRow { x: 8px; y: 110px; width: 304px; label: "服务端口";   mode: 0; value: root.port-text; focused: root.focus-idx == 5; disabled: root.port-disabled; }
    SettingRow { x: 8px; y: 128px; width: 304px; label: "清空数据";   mode: 0; value: "全部删除"; focused: root.focus-idx == 6; }
}

// 底栏：键帽方块 + 文字，右对齐 Esc（参照原型 .kb）
component KeyCap inherits Rectangle {
    in property <string> label: "";
    in property <length> w: 14px;
    width: root.w; height: 13px; border-radius: 3px;
    background: #22303A; border-width: 1px; border-color: #31424E;
    Text {
        x: 0; y: 0; width: parent.width; height: parent.height; vertical-alignment: center;
        horizontal-alignment: TextHorizontalAlignment.center;
        text: root.label; color: #CFEAE4;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 9px;
    }
}

component HintText inherits Text {
    height: 18px; vertical-alignment: center; color: #6E7B88;
    font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
}

component ArrowPair inherits Rectangle {
    in property <bool> vertical: false;
    width: 34px; height: 15px; border-radius: 3px;
    background: #22303A; border-width: 1px; border-color: #31424E;
    Image {
        x: 4px; y: 1px; width: 12px; height: 12px;
        source: root.vertical ? @image-url("icons/arrow-up.svg") : @image-url("icons/arrow-left.svg");
    }
    Image {
        x: 18px; y: 1px; width: 12px; height: 12px;
        source: root.vertical ? @image-url("icons/arrow-down.svg") : @image-url("icons/arrow-right.svg");
    }
}

component HintRow inherits Rectangle {
    in property <int> page: 0;
    in property <bool> overlay: false;
    in property <bool> adjust: true;
    in property <bool> editing: false;
    in property <bool> selecting: false;
    in property <int> sel-count: 0;
    in property <string> hint: "";
    height: 18px;
    background: root.overlay ? #0F1419E8 : #0F1419;
    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #1C242B; }

    // 主页
    if root.page == 0 : KeyCap  { x: 8px;   y: 2px; label: "Enter"; w: 30px; }
    if root.page == 0 : HintText { x: 41px; y: 0; text: "打开"; }
    if root.page == 0 : KeyCap  { x: parent.width - 74px; y: 2px; label: "Esc"; w: 22px; }
    if root.page == 0 : HintText { x: parent.width - 50px; y: 0; text: "长按退出"; }

    // 相册：多选态显示已选数量与操作提示
    if root.page == 1 && root.selecting : Text {
        x: 8px; y: 0; height: 18px; vertical-alignment: center;
        text: "已选 " + root.sel-count + " 项    空格 选择    退格 删除    Esc 取消";
        color: #2DD4BF; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
    }
    if root.page == 1 && !root.selecting : ArrowPair { x: 8px; y: 2px; vertical: false; }
    if root.page == 1 && !root.selecting : HintText { x: 41px; y: 0; text: "移动"; }
    if root.page == 1 && !root.selecting : KeyCap  { x: 74px;  y: 2px; label: "Enter"; w: 30px; }
    if root.page == 1 && !root.selecting : HintText { x: 107px; y: 0; text: "预览"; }
    if root.page == 1 && !root.selecting : KeyCap  { x: 138px; y: 2px; label: "空格"; w: 26px; }
    if root.page == 1 && !root.selecting : HintText { x: 167px; y: 0; text: "多选"; }
    if root.page == 1 && !root.selecting : KeyCap  { x: parent.width - 60px; y: 2px; label: "退格"; w: 26px; }
    if root.page == 1 && !root.selecting : HintText { x: parent.width - 31px; y: 0; text: "删除"; }

    // 预览
    if root.page == 2 : ArrowPair { x: 8px; y: 2px; vertical: false; }
    if root.page == 2 : HintText { x: 41px; y: 0; text: "切换"; }
    if root.page == 2 : KeyCap  { x: parent.width - 106px; y: 2px; label: "退格"; w: 26px; }
    if root.page == 2 : HintText { x: parent.width - 77px; y: 0; text: "删除"; }
    if root.page == 2 : KeyCap  { x: parent.width - 48px; y: 2px; label: "Esc"; w: 22px; }
    if root.page == 2 : HintText { x: parent.width - 23px; y: 0; text: "返回"; }

    // 设置：编辑态显示动态提示；否则方向键选择，仅档位项显示左右调整
    if root.page == 3 && root.editing : HintText { x: 8px; y: 0; text: root.hint; }
    if root.page == 3 && !root.editing : ArrowPair { x: 8px; y: 2px; vertical: true; }
    if root.page == 3 && !root.editing : HintText { x: 47px; y: 0; text: "选择"; }
    if root.page == 3 && !root.editing && root.adjust : ArrowPair { x: 78px; y: 2px; vertical: false; }
    if root.page == 3 && !root.editing && root.adjust : HintText { x: 117px; y: 0; text: "调整"; }
    if root.page == 3 && !root.editing && !root.adjust && root.hint != "" : HintText { x: 78px; y: 0; text: root.hint; }
    if root.page == 3 && !root.editing : KeyCap  { x: parent.width - 48px; y: 2px; label: "Esc"; w: 22px; }
    if root.page == 3 && !root.editing : HintText { x: parent.width - 23px; y: 0; text: "返回"; }
}

export component AppWindow inherits Window {
    title: "CardShot";
    width: 320px; height: 170px;
    background: #0B0E11;

    in property <int> page: 0;
    in property <string> page-title: "CardShot";
    in property <bool> recording: false;
    in property <string> rec-time: "";
    in property <int> home-focus: 0;
    in property <int> grid-focus: 0;
    in property <bool> selecting: false;
    in property <int> sel-count: 0;
    in property <[GalleryItem]> items;
    in property <image> preview-img;
    in property <string> preview-name: "";
    in property <string> preview-size: "";
    in property <string> preview-dur: "";
    in property <string> preview-kind: "image";
    in property <string> preview-pos: "";
    in property <int> count-images: 0;
    in property <int> count-videos: 0;
    in property <string> size-label: "";
    in property <string> hint: "";
    in property <string> toast: "";
    in property <bool> help-visible: false;
    in property <bool> confirm-visible: false;
    in property <int> confirm-focus: 0;
    in property <int> set-focus: 0;
    in property <string> s-fmt: "PNG";
    in property <int> s-quality: 90;
    in property <int> s-fps: 20;
    in property <int> s-port: 8420;
    in property <string> s-shot: "";
    in property <string> s-remote: "开";
    in property <string> s-port-text: "8420";
    in property <bool> port-edit: false;
    in property <bool> port-disabled: false;
    in property <bool> hotkey-capture: false;
    in property <bool> video-ended: false;
    in property <bool> settings-adjust: true;
    in property <bool> settings-editing: false;
    in property <string> confirm-title: "删除当前内容";
    in property <string> confirm-desc: "是否确认进行删除？删除后将无法恢复";

    if root.page == 2 : Image {
        x: 0; y: 0; width: parent.width; height: parent.height;
        source: root.preview-img; image-fit: fill;
    }
    TopBar {
        width: parent.width; y: 0;
        title: root.page-title;
        recording: root.recording;
        rec-time: root.rec-time;
        overlay: root.page == 2;
        wide-right: root.page == 2;
    }
    if root.page == 0 : HomeScreen {
        y: 0; width: parent.width; height: parent.height - 18px;
        focus-idx: root.home-focus;
        count-images: root.count-images; count-videos: root.count-videos; size-label: root.size-label;
    }
    if root.page == 1 : GalleryScreen {
        y: 0; width: parent.width; height: parent.height - 18px;
        items: root.items; focus-idx: root.grid-focus; selecting: root.selecting; sel-count: root.sel-count;
    }
    if root.page == 2 : PreviewScreen {
        y: 0; width: parent.width; height: parent.height;
        img: root.preview-img; name: root.preview-name; size-label: root.preview-size; dur: root.preview-dur; kind: root.preview-kind; pos: root.preview-pos; ended: root.video-ended;
    }
    if root.page == 3 : SettingsScreen {
        y: 0; width: parent.width; height: parent.height - 18px;
        focus-idx: root.set-focus; fmt: root.s-fmt; quality: root.s-quality; fps: root.s-fps;
        port: root.s-port; shot: root.s-shot; remote: root.s-remote;
        port-text: root.s-port-text; shot-text: root.s-shot;
        port-disabled: root.port-disabled;
    }
    HintRow { width: parent.width; y: parent.height - 18px; page: root.page; overlay: root.page == 2; hint: root.hint; adjust: root.settings-adjust; editing: root.settings-editing; selecting: root.selecting; sel-count: root.sel-count; }

    if root.toast != "" : Rectangle {
        x: parent.width - 120px; y: parent.height - 32px; width: 112px; height: 16px;
        border-radius: 8px; background: #1D2A32; border-width: 1px; border-color: #2A3A45;
        Text {
            x: 0; y: 0; width: parent.width; height: parent.height; vertical-alignment: center;
            horizontal-alignment: TextHorizontalAlignment.center;
            text: root.toast; color: #C8D2DC;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        }
    }

    if root.help-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000C0;
        Rectangle {
            x: 24px; y: 12px; width: 272px; height: 132px;
            border-radius: 10px; background: #14191E; border-width: 1px; border-color: #2A3A45;
            Text {
                x: 14px; y: 8px; width: 240px; height: 16px; vertical-alignment: center;
                text: "按键"; color: #E6EDF3;
                font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px; font-weight: 700;
            }
            ArrowPair { x: 14px; y: 28px; width: 34px; height: 15px; vertical: false; }
            Text { x: 54px; y: 28px; width: 200px; height: 15px; vertical-alignment: center; text: "左右切换"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            ArrowPair { x: 14px; y: 44px; width: 34px; height: 15px; vertical: true; }
            Text { x: 54px; y: 44px; width: 200px; height: 15px; vertical-alignment: center; text: "上下选择"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { x: 14px; y: 60px; width: 240px; height: 12px; vertical-alignment: center; text: "Enter  打开 确认"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { x: 14px; y: 74px; width: 240px; height: 12px; vertical-alignment: center; text: "空格  多选"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { x: 14px; y: 88px; width: 240px; height: 12px; vertical-alignment: center; text: "退格  删除"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { x: 14px; y: 102px; width: 240px; height: 12px; vertical-alignment: center; text: "Shift + 退格  直接删除"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { x: 14px; y: 116px; width: 240px; height: 12px; vertical-alignment: center; text: "Esc 返回；主界面长按退出"; color: #AEBAC6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
        }
    }

    if root.confirm-visible : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #000000C0;
        Rectangle {
            x: 34px; y: 44px; width: 252px; height: 84px;
            border-radius: 10px; background: #14191E; border-width: 1px; border-color: #5A2B2B;
            Text {
                x: 16px; y: 10px; width: 220px; height: 16px; vertical-alignment: center;
                text: root.confirm-title; color: #E6EDF3;
                font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px; font-weight: 700;
            }
            Text {
                x: 16px; y: 28px; width: 220px; height: 12px; vertical-alignment: center;
                text: root.confirm-desc; color: #C98A8A;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            }
            Rectangle {
                x: 16px; y: 50px; width: 102px; height: 24px; border-radius: 7px;
                background: #1A2027; border-width: 1px;
                border-color: root.confirm-focus == 0 ? #2DD4BF : #2A323B;
                Text {
                    x: 0; y: 0; width: parent.width; height: parent.height; vertical-alignment: center;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    text: "取消"; color: root.confirm-focus == 0 ? #E6EDF3 : #AEBAC6;
                    font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px;
                }
            }
            Rectangle {
                x: 134px; y: 50px; width: 102px; height: 24px; border-radius: 7px;
                background: root.confirm-focus == 1 ? #7F2A2A : #5A2222; border-width: 1px;
                border-color: root.confirm-focus == 1 ? #F26D6D : #7F3A3A;
                Text {
                    x: 0; y: 0; width: parent.width; height: parent.height; vertical-alignment: center;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    text: "删除"; color: #FFE2E2;
                    font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px;
                }
            }
        }
    }
}
