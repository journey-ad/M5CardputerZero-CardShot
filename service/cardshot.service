[Unit]
Description=CardShot 后台截图/录屏服务 (Rust)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/cardshot
ExecStart=%h/.local/share/cardshot/cardshotd --config %h/.config/cardshot/config.json
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
